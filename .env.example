# ==========================================
# LLM API Configuration
# ==========================================
# Supported providers: OpenAI, Azure OpenAI, DeepSeek, etc.
# Refer to https://api-docs.deepseek.com/ for DeepSeek specific details.

# The name of the model to use (e.g., "deepseek-chat", "gpt-4", "gpt-3.5-turbo")
LLM_MODEL=deepseek-chat

# The base URL for the API endpoint.
# For OpenAI: https://api.openai.com/v1
# For DeepSeek: https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com

# Your API Key.
LLM_API_KEY=sk-xxxxxx

# ==========================================
# Azure OpenAI Configuration (Optional)
# ==========================================
# Uncomment and configure the following lines if you are using Azure OpenAI.

# The API version for Azure OpenAI (e.g., "2025-01-01-preview")
# API_VERSION=2025-01-01-preview

# Set to "azure" if using Azure OpenAI, otherwise leave commented or set to "openai"
# OPENAI_PROVIDER=azure
